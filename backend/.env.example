# Copy to .env and fill in. Everything has a sensible default for local dev.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# needed for the admin login over https, e.g. https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# where the frontend runs
CORS_ALLOWED_ORIGINS=http://localhost:3000
# optional, lets Vercel preview deployments call the API too, e.g. ^https://garagemate-.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# Gemini is optional. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# rate limits per IP
THROTTLE_ANON=120/min
THROTTLE_CHAT=20/min
THROTTLE_UPLOAD=15/min
THROTTLE_BOOKING=10/min

# production paths (see deploy/)
# SQLITE_PATH=/home/ubuntu/garagemate/backend/db.sqlite3
# MEDIA_ROOT=/var/www/garagemate/media
# CACHE_DIR=/home/ubuntu/garagemate/backend/.cache
