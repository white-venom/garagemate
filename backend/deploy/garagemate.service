[Unit]
Description=GarageMate API (gunicorn)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/garagemate/backend
# 2 workers is about what a 1 GB t2.micro can take. Gemini calls can be slow,
# hence the long timeout.
ExecStart=/home/ubuntu/garagemate/backend/.venv/bin/gunicorn config.wsgi:application \
    --workers 2 --threads 2 --timeout 90 \
    --bind 127.0.0.1:8000 \
    --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
